// Schéma Prisma — base SQLite locale pour le suivi de paris hippiques.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Cheval favori suivi par l'utilisateur.
model Horse {
  id            Int      @id @default(autoincrement())
  name          String
  sex           String? // M / F / H (hongre)
  age           Int?
  discipline    String? // attele / monte / plat / obstacle / trot
  usualDriver   String? // driver ou jockey habituel
  favHippodrome String? // hippodrome de prédilection
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Course sauvegardée manuellement par l'utilisateur (snapshot figé).
/// Contrairement au cache réseau, elle est conservée durablement : elle mémorise
/// les partants et les cotes telles qu'affichées au moment de la sauvegarde
/// (utile quand on a parié sur la course), sans re-fetch PMU à la relecture.
model SavedRace {
  id        Int      @id @default(autoincrement())
  date      String // AAAA-MM-JJ
  reunion   Int
  course    Int
  label     String? // ex. hippodrome / nom de course, pour l'affichage
  startTime BigInt? // epoch ms, si connu (pour info/tri) — dépasse la capacité 32 bits d'Int
  payload   String // JSON sérialisé de la ProviderRace (partants + cotes figées)
  savedAt   DateTime @default(now())

  @@unique([date, reunion, course])
}

/// Pari réellement joué (base du suivi comptable).
model Bet {
  id        Int      @id @default(autoincrement())
  date      String // AAAA-MM-JJ
  betType   String // simple_gagnant, couple_place, tierce, quinte...
  label     String? // description libre (chevaux joués, course...)
  stake     Float
  odds      Float? // cote/rapport encaissé si gagné
  status    String   @default("pending") // pending | won | lost
  payout    Float? // gain brut encaissé
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Mouvement de bankroll hors pari (dépôt / retrait).
model Transaction {
  id        Int      @id @default(autoincrement())
  date      String
  type      String // deposit | withdrawal
  amount    Float
  note      String?
  createdAt DateTime @default(now())
}

/// Cache brut des réponses de l'API PMU turfinfo (limite les appels réseau).
model RawPmuSnapshot {
  id        Int      @id @default(autoincrement())
  cacheKey  String   @unique // ex: programme:2026-07-03  ou  race:2026-07-03:1:1
  payload   String // JSON sérialisé
  fetchedAt DateTime @default(now())
}
