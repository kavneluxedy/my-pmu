{
  "name": "@pmu/api",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build --workspace @pmu/engine",
    "dev": "cross-env PORT=3002 tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prestart": "npm run build --workspace @pmu/engine",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@pmu/engine": "*",
    "@prisma/client": "^5.20.0",
    "fastify": "^5.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "cross-env": "^7.0.3",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}